# Keep local values blank in this committed template.
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=
OPENAI_ANSWER_MODEL=gpt-5.6-luna
FLASK_SECRET_KEY=
AI_KNOWLEDGE_ASSISTANT_ENV=
# Set by most hosts (Render sets this automatically); local development falls back to 5000.
PORT=
# Optional controlled temporary-workspace location.
WORKSPACE_ROOT=
# Optional deployment safeguards. Keep client uploads disabled for public demos.
ALLOW_CLIENT_UPLOADS=
KNOWLEDGE_RUN_TTL_SECONDS=
MAX_REQUEST_BYTES=
MAX_FILE_BYTES=
MAX_DOCUMENTS_PER_RUN=
MAX_TOTAL_UPLOAD_BYTES=
MAX_CHUNKS_PER_RUN=
MAX_QUESTION_LENGTH=
MAX_ACTIVE_RUNS=
